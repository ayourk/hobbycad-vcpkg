{
  "$comment": "Qt 6 Base + SVG Modules for HobbyCAD static builds",
  "name": "qtbase",
  "version": "6.4.2",
  "port-version": 16,
  "description": "Qt Application Framework Base Module (Core, GUI, Widgets, OpenGL) + SVG Module",
  "homepage": "https://www.qt.io/",
  "license": "LGPL-3.0-only",
  "supports": "!uwp & !android & !ios",
  "dependencies": [
    "double-conversion",
    {
      "name": "freetype",
      "default-features": false
    },
    "harfbuzz",
    "libjpeg-turbo",
    "libpng",
    {
      "name": "opengl",
      "platform": "!osx"
    },
    "pcre2",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    "zlib"
  ]
}
